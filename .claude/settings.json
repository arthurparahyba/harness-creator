{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/gate-destructive.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/registrar-sessao.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/format-on-edit.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/registrar-sessao.sh"
          }
        ]
      }
    ]
  }
}
